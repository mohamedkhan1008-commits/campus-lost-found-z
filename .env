# Use sqlite as fallback and avoid needing local MySQL while developing
DB_TYPE=sqlite
SQLITE_FILE=data/campus_lost_found.sqlite

# If you want to use MySQL instead, comment the DB_TYPE line and configure below:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=campus_lost_found

JWT_SECRET=your_jwt_secret_here
PORT=5000
NODE_ENV=development